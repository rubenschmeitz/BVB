---
layout: layouts/base.njk
permalink: /index.html
pageKey: home
activeNav: home
bodyClass: home-page
scripts:
---
{% set pageContent = pages.home %}
{% set showcase = pageContent.showcase | published %}
{% set featuredEvents = contentCollections.events | featuredEvents %}
{% set promotion = featuredEvents[0] %}
<div class="page-hero">
    <div class="page-hero-bg {{ pageContent.hero.className }}"></div>
    <div class="page-hero-content">
        <p>{{ pageContent.hero.eyebrow }}</p>
        <h1>{{ pageContent.hero.title }}</h1>
    </div>
</div>

<main class="content-area">
    <div class="content-container-wide">
        <section class="home-story-section reveal-on-scroll reveal-left">
            <div class="home-story-layout">
                <div class="home-story-copy">
                    <p class="lead lead-alt">{{ pageContent.story.lead }}</p>
                    {% for paragraph in pageContent.story.paragraphs %}
                    <p>{{ paragraph }}</p>
                    {% endfor %}
                    <div class="action-row">
                        {% for button in pageContent.story.buttons %}
                        <a href="{{ button.url }}" class="button-{{ button.style }}">{{ button.label }}</a>
                        {% endfor %}
                    </div>
                </div>

                <div class="home-gallery-section">
                    <div class="home-insta-widget" data-home-gallery>
                        <div class="home-insta-header">
                            <span class="home-insta-avatar">
                                <img src="images/instagram_profile.jpg" alt="" width="100" height="100" loading="lazy" decoding="async">
                            </span>
                            <span class="home-insta-account">
                                <strong>bonsaiverenigingbrabant</strong>
                                <span>{{ site.name }}</span>
                            </span>
                            <span class="home-widget-actions">
                                <a href="{{ site.social[0].url }}" target="_blank" rel="noopener noreferrer" class="home-insta-follow" aria-label="Volg {{ site.name }} op Instagram">
                                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                                    Instagram
                                </a>
                                <a href="{{ site.social[1].url }}" target="_blank" rel="noopener noreferrer" class="home-insta-follow home-facebook-follow" aria-label="Volg {{ site.name }} op Facebook">
                                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.67 13.5l.6-3.92h-3.76V7.04c0-1.07.52-2.12 2.21-2.12h1.71V1.58S15.88 1.31 14.4 1.31c-3.08 0-5.09 1.87-5.09 5.25v3.02H5.89v3.92h3.42V23h4.2v-9.5h3.16z"/></svg>
                                    Facebook
                                </a>
                            </span>
                        </div>
                        <div class="home-gallery-body">
                            <div class="home-showcase-carousel">
                                <div class="home-showcase-track">
                                    <figure class="home-showcase-slide is-active" data-gallery-title="{{ promotion.homePromotion.title | escape }}" data-gallery-copy="Op {{ promotion | dutchDateRange }} {{ promotion.homePromotion.copyAfterDate | escape }}" data-gallery-link="{{ promotion.detailsUrl }}" data-gallery-link-text="{{ promotion.homePromotion.linkLabel | escape }}">
                                        <a href="{{ promotion.detailsUrl }}" class="home-showcase-link" aria-label="Bekijk de NBS-pagina">
                                            <img src="{{ promotion.homePromotion.image }}" alt="{{ promotion.homePromotion.alt }}" width="{{ promotion.homePromotion.image | imageWidth(promotion.homePromotion.width) }}" height="{{ promotion.homePromotion.image | imageHeight(promotion.homePromotion.height) }}" decoding="async">
                                        </a>
                                    </figure>
                                    {% for item in showcase %}
                                    <figure class="home-showcase-slide" data-gallery-title="{{ item.title | escape }}" data-gallery-copy="{{ item.description | escape }}" data-gallery-link="{{ item.url }}" data-gallery-link-text="{{ item.linkLabel | escape }}">
                                        <img src="{{ item.image }}" alt="{{ item.alt }}" width="{{ item.image | imageWidth(item.width) }}" height="{{ item.image | imageHeight(item.height) }}" loading="lazy" decoding="async">
                                    </figure>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="home-insta-caption">
                                <h3 data-home-gallery-title>{{ promotion.homePromotion.title }}</h3>
                                <p data-home-gallery-copy>Op {{ promotion | dutchDateRange }} {{ promotion.homePromotion.copyAfterDate }}</p>
                                <div class="home-gallery-controls">
                                    <span data-home-gallery-counter>1 / {{ showcase.length + 1 }}</span>
                                    <a href="{{ promotion.detailsUrl }}" data-home-gallery-link>{{ promotion.homePromotion.linkLabel }}</a>
                                </div>
                            </div>
                            <button type="button" class="home-gallery-nav home-gallery-prev" data-home-gallery-prev aria-label="Vorige foto">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                            </button>
                            <button type="button" class="home-gallery-nav home-gallery-next" data-home-gallery-next aria-label="Volgende foto">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>
