---
layout: layouts/base.njk
permalink: /agenda.html
pageKey: agenda
activeNav: agenda
bodyClass:
heroImage: images/tokonoma/05_tokonoma_mei_2024.webp
headScripts:
  - calendar-button.js
scripts:
  - agenda-data.js
  - agenda.js
---
{% set pageContent = pages.agenda %}
<div class="page-hero flipped show-tip">
        <div class="page-hero-bg {{ pageContent.hero.className }}"></div>
        <div class="page-hero-content">
            <p>{{ pageContent.hero.eyebrow }}</p>
            <h1>{{ pageContent.hero.title }}</h1>
        </div>
    </div>

    <main class="content-area">
        <div class="content-container-wide">
            <div class="agenda-grid-layout agenda-single-layout">

                <!-- Main Agenda Column -->
                <div class="agenda-main-column">
                    <p class="large-text mb-2 reveal-on-scroll">
                        {{ pageContent.intro.beforeVenue }} <strong>{{ pageContent.intro.venueLabel }}</strong>. {{ pageContent.intro.afterVenue }}
                    </p>

                    <!-- Control Panel (Filters & View Toggles) -->
                    <div class="agenda-controls reveal-on-scroll">
                        <details class="mobile-filter-panel" data-mobile-collapsible open>
                            <summary>Filter: Clubavonden</summary>
                            <div class="filter-group">
                                <button type="button" class="filter-btn" data-filter="all">{{ pageContent.filters.all }}</button>
                                <button type="button" class="filter-btn active" data-filter="club"><span class="dot-legend club"></span>{{ pageContent.filters.club }}</button>
                                <button type="button" class="filter-btn" data-filter="nbv"><span class="dot-legend nbv"></span>{{ pageContent.filters.nbv }}</button>
                                <button type="button" class="filter-btn" data-filter="event"><span class="dot-legend event"></span>{{ pageContent.filters.event }}</button>
                            </div>
                        </details>
                        <div class="view-toggle">
                            <button type="button" class="toggle-btn active" id="view-list" aria-label="Lijstweergave">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                                <span>Lijst</span>
                            </button>
                            <button type="button" class="toggle-btn" id="view-calendar" aria-label="Kalenderweergave">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <span>Maand</span>
                            </button>
                        </div>
                        <a href="docs/bvb_agenda_2026.ics" class="sync-btn agenda-sync-action">{{ pageContent.syncLabel }}</a>
                    </div>

                    <!-- Dynamic Content Container -->
                    <div id="agenda-dynamic-content" class="agenda-dynamic-content list-view">
                        <!-- Content will be injected dynamically here -->
                    </div>

                    <section class="agenda-location-section reveal-on-scroll">
                        <h3>{{ pageContent.locationHeading }}</h3>
                        <p><strong>{{ site.venue.name }}</strong><br>{{ site.venue.street }}, {{ site.venue.postalCode }} {{ site.venue.city }}</p>
                        <p class="fine-print">{{ pageContent.parkingText }}</p>

                        <div class="map-iframe-wrapper" >
                            <iframe title="Kaart van De Moerkoal in Berlicum" class="map-frame"
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2474.8251411929564!2d5.4156872761828785!3d51.66303779932199!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c6e5ca14c47fcd%3A0x6740ba1b23b26f1e!2sStichting%20De%20Moerkoal!5e0!3m2!1snl!2snl!4v1777793012084!5m2!1snl!2snl"
                                width="600"
                                height="450"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                    </section>

                </div> <!-- End of agenda-main-column -->

            </div> <!-- End of agenda-grid-layout -->
        </div>
    </main>
